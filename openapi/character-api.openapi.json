  "servers": [
    {
      "url": "//localhost:8080"
    }
  ],
  "components": {
    "securitySchemes": {
      "InternalAPIKey": {
        "description": "内部サービス間認証キー",
        "in": "header",
        "name": "X-Internal-API-Key",
        "type": "apiKey"
      }
    },
    "schemas": {
      "dto.CharacterListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/dto.CharacterResponse"
            },
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "dto.CharacterResponse": {
        "properties": {
          "birthDate": {
            "type": "string"
          },
          "birthPlace": {
            "type": "string"
          },
          "bodyFatPercentage": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "heightCm": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "race": {
            "type": "string"
          },
          "raceId": {
            "type": "string"
          },
          "sizeBottom": {
            "type": "integer"
          },
          "sizeMiddle": {
            "type": "integer"
          },
          "sizeTop": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string"
          },
          "version": {
            "description": "楽観ロック用。更新時に If-Match で送り返す",
            "type": "integer"
          },
          "weightKg": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "dto.CreateCharacterRequest": {
        "properties": {
          "birthDate": {
            "type": "string"
          },
          "birthPlace": {
            "maxLength": 150,
            "type": "string"
          },
          "bodyFatPercentage": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "description": {
            "maxLength": 5000,
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "heightCm": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "raceId": {
            "type": "string"
          },
          "sizeBottom": {
            "minimum": 1,
            "type": "integer"
          },
          "sizeMiddle": {
            "minimum": 1,
            "type": "integer"
          },
          "sizeTop": {
            "minimum": 1,
            "type": "integer"
          },
          "weightKg": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": ["gender", "name", "raceId"],
        "type": "object"
      },
      "dto.CreateRaceRequest": {
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "dto.ErrorResponse": {
        "properties": {
          "details": {
            "additionalProperties": {},
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "dto.RaceResponse": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "dto.UpdateCharacterRequest": {
        "properties": {
          "birthDate": {
            "type": "string"
          },
          "birthPlace": {
            "maxLength": 150,
            "type": "string"
          },
          "bodyFatPercentage": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "description": {
            "maxLength": 5000,
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "heightCm": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "raceId": {
            "type": "string"
          },
          "sizeBottom": {
            "minimum": 1,
            "type": "integer"
          },
          "sizeMiddle": {
            "minimum": 1,
            "type": "integer"
          },
          "sizeTop": {
            "minimum": 1,
            "type": "integer"
          },
          "weightKg": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "dto.UpdateRaceRequest": {
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      }
    }
  }
}
