{
  "openapi": "3.0.0",
  "info": {
    "contact": {},
    "description": "キャラクター管理 REST API",
    "title": "Character API",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/characters": {
      "get": {
        "description": "?ids=<uuid,...> でバッチ取得、?limit= / ?offset= でページング",
        "parameters": [
          {
            "description": "カンマ区切りの UUID（指定時はその ID のみ返す）",
            "in": "query",
            "name": "ids",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "最大件数（1..500）",
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "オフセット",
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.CharacterListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalAPIKey": []
          }
        ],
        "summary": "キャラクター一覧取得",
        "tags": ["characters"]
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/dto.CreateCharacterRequest"
              }
            }
          },
          "description": "キャラクター作成リクエスト",
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.CharacterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalAPIKey": []
          }
        ],
        "summary": "キャラクター作成",
        "tags": ["characters"]
      }
    },
    "/api/v1/characters/{id}": {
