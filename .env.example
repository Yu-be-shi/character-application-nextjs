# ================================================================
# このファイルを .env にコピーして値を埋めてください
# .env は .gitignore で除外されています
# ================================================================

# ── キャラクターDB (PostgreSQL) ────────────────────────────────
CHAR_DB_NAME=characters
CHAR_DB_USER=app
CHAR_DB_PASSWORD=changeme_char_password

# ── ユーザーDB (MySQL) ─────────────────────────────────────────
USER_DB_NAME=userdb
USER_DB_USER=app
USER_DB_PASSWORD=changeme_user_password
USER_DB_ROOT_PASSWORD=changeme_root_password

# ── サービス間認証キー ─────────────────────────────────────────
# 生成コマンド: openssl rand -hex 32
INTERNAL_API_KEY=replace_with_random_32byte_hex

# ── character-api の冪等性キー用 Redis（character-api 専有）─────────
# 既定は api-go-infra の compose が起動する character-api-redis:6379。
# 空にすると冪等性機能は無効（ローカルで Redis を使わない場合）。
REDIS_ADDR=character-api-redis:6379

# ── NextAuth ───────────────────────────────────────────────────
# 生成コマンド: openssl rand -hex 32
AUTH_SECRET=replace_with_random_32byte_hex
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
NEXTAUTH_URL=http://localhost:3000

# ── その他 ─────────────────────────────────────────────────────
LOG_LEVEL=info
