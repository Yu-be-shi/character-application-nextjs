# ================================================================
# このファイルを .env にコピーして値を埋めてください
# .env は .gitignore で除外されています
#
# ここにあるのは「このリポジトリの compose（MySQL + Next.js）が読む変数」だけです。
# キャラクター DB / API の変数（CHAR_DB_* / REDIS_ADDR / LOG_LEVEL 等）は
# それぞれ character-db-infra / character-api-go-infra の .env が管理します。
# ================================================================

# ── ユーザーDB (MySQL) ─────────────────────────────────────────
USER_DB_NAME=userdb
USER_DB_USER=app
USER_DB_PASSWORD=changeme_user_password
USER_DB_ROOT_PASSWORD=changeme_root_password

# ── サービス間認証キー ─────────────────────────────────────────
# 生成コマンド: openssl rand -hex 32
# ※ character-api 側（apis/character-api-go-infra の .env）の INTERNAL_API_KEY と
#   必ず同じ値にすること（不一致だと API が 401 を返す）。
INTERNAL_API_KEY=replace_with_random_32byte_hex

# ── 内部メンテナンス（/api/internal/reconcile）────────────────────
# 未設定なら INTERNAL_API_KEY（= CHARACTER_API_KEY）にフォールバックする。
# RECONCILE_API_KEY=replace_with_random_32byte_hex

# ── NextAuth ───────────────────────────────────────────────────
# 生成コマンド: openssl rand -hex 32
AUTH_SECRET=replace_with_random_32byte_hex
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
NEXTAUTH_URL=http://localhost:3000
# ローカル docker（NODE_ENV=production）で Auth.js の UntrustedHost エラーを回避する。
AUTH_TRUST_HOST=true

# ── compose を使わず `npm run dev` で動かす場合のみ ───────────────
# compose 利用時は docker-compose.yml が注入するため不要。
# DATABASE_URL=mysql://app:changeme_user_password@127.0.0.1:3306/userdb
# CHARACTER_API_URL=http://127.0.0.1:8080
# CHARACTER_API_KEY=replace_with_random_32byte_hex
